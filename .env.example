# Core Django
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-before-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=UTC

# Database
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_DB_CONN_MAX_AGE=60

# Security
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_HTTPONLY=False
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_X_FRAME_OPTIONS=DENY

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=hmoo <noreply@example.com>
SERVER_EMAIL=hmoo <server@example.com>

# Static and media
STATIC_ROOT=
MEDIA_ROOT=
MEDIA_URL=/media/
DJANGO_DEFAULT_FILE_STORAGE=config.storage.LocalMediaStorage

# Logging
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_TO_FILES=False
DJANGO_LOG_DIR=logs

# Future storage / platform integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
